# Unity 生成物（.meta 和 ProjectSettings 要进库，别忽略）
Unity/Library/
Unity/Temp/
Unity/Logs/
Unity/UserSettings/
Unity/.vs/
Unity/*.sln
Unity/*.csproj
Unity/obj/

# ZCode 工具会话文件
.zcode/

# 可再生产物（出包/打包按钮生成，随时可删重出）
PatchSource/
Build/

# TMP 字体资产超 GitHub 100MB 限制，只留本地不进库（需要时在 Unity 里对字体右键重新生成）
Unity/Assets/Font/*.asset

# 素材库是独立仓库（单独给美术开权限），不进本仓库
CardGame_Arts/

# OS
Thumbs.db
.DS_Store
